SECRET_KEY=replace-with-a-random-secret
DEBUG=True
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1
# Produccion: usa el dominio exacto, sin https:// (ej. miapp.up.railway.app).
# ALLOWED_HOSTS=miapp.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://miapp.up.railway.app
CSRF_TRUSTED_ORIGINS=
DATABASE_URL=
SERVE_MEDIA=True
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# Protección de inicio de sesión (django-axes)
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=30
SESSION_COOKIE_DAYS=30

# OpenRouter (requeridos solo para procesar fuentes con IA)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=LifeMaxx
OPENROUTER_TIMEOUT=90
OPENROUTER_RETRIES=2

# ImageKit · paquete fotografico corporal
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_FOLDER=/lifemaxx/body
